    const int ARRAY_SIZE = 1000; // Размер массива

    vector<int> arr = generateRandomArray(ARRAY_SIZE, 1, 1000);

    cout << "Исходный массив:" << endl;
    printArray(arr);

    // Сортировка массива
    radixSort(arr);

    // Вывод отсортированного массива
    cout << "Отсортированный массив:" << endl;
    printArray(arr);

    return 0;
}
