#include <iostream>
#include <cstdlib>
#include <ctime>

using namespace std;

// Простая версия сортировки вставками
void insertionSort(int arr[], int n) 
{
    for (int i = 1; i < n; i++) 
    {
        int key = arr[i];
        int j = i - 1;

        // Сдвигаем элементы большие чем key
        while (j >= 0 && arr[j] > key) 
        {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key;
    }
}

// Функция для вывода массива
void printArray(int arr[], int n) 
{
    for (int i = 0; i < n; i++) 
    {
        cout << arr[i] << " ";
    }
    cout << endl;
}

int main() 
{
    setlocale(LC_ALL, "Russian");
    srand(time(nullptr));

    const int SIZE = 10; //Размер массива
    int arr[SIZE];

    // Заполняем массив случайными числами
    cout << "Исходный массив: ";
    for (int i = 0; i < SIZE; i++) 
{
        arr[i] = rand() % 100 + 1;
        cout << arr[i] << " ";
    }
    cout << endl;

    // Сортируем массив
    insertionSort(arr, SIZE);

    // Выводим результат
    cout << "Отсортированный массив: ";
    printArray(arr, SIZE);

    return 0;
}
