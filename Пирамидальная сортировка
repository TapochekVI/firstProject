#include <iostream>
#include <cstdlib>
#include <ctime>
#include <vector>

using namespace std;

// Пирамидальная сортировка
void heapifySimple(vector<int>& arr, int n, int i) {
    int largest = i;
    int left = 2 * i + 1;
    int right = 2 * i + 2;

    if (left < n && arr[left] > arr[largest])
        largest = left;

    if (right < n && arr[right] > arr[largest])
        largest = right;

    if (largest != i) {
        swap(arr[i], arr[largest]);
        heapifySimple(arr, n, largest);
    }
}

void heapSortSimple(vector<int>& arr) {
    int n = arr.size();

    // Построение кучи
    for (int i = n / 2 - 1; i >= 0; i--)
        heapifySimple(arr, n, i);

    // Извлечение элементов из кучи
    for (int i = n - 1; i > 0; i--) {
        swap(arr[0], arr[i]);
        heapifySimple(arr, i, 0);
    }
}

void printArray(const vector<int>& arr) {
    for (int num : arr) {
        cout << num << " ";
    }
    cout << endl;
}

int main() {
    setlocale(LC_ALL, "Russian");
    srand(time(nullptr));

    const int SIZE = 10;
    vector<int> arr(SIZE);

    // Заполняем массив случайными числами
    cout << "Исходный массив: ";
    for (int i = 0; i < SIZE; i++) {
        arr[i] = rand() % 100 + 1;
        cout << arr[i] << " ";
    }
    cout << endl;

    // Сортируем массив
    heapSortSimple(arr);

    // Выводим результат
    cout << "Отсортированный массив: ";
    printArray(arr);

    return 0;
}
